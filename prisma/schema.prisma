// Cinema Dub — data model. Postgres (Neon) via Prisma.
// Conventions mirror ../digital_standarts: cuid ids, camelCase fields, createdAt defaults.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Clerk owns identity; we mirror users in via the user.created/updated webhook.
model User {
  id              String         @id @default(cuid())
  clerkId         String         @unique
  displayName     String         @default("")
  avatarColor     String         @default("#FFD23F")
  runs            Run[]
  takes           Take[]
  hostedRooms     Room[]         @relation("RoomHost")
  ratingsReceived PlayerRating[] @relation("RatedUser")
  createdAt       DateTime       @default(now())
}

// A collection of scenes shipped together ("Cursed Cinema", etc.).
model Pack {
  id         String   @id @default(cuid())
  name       String
  subtitle   String   @default("")
  coverUrl   String?
  isOfficial Boolean  @default(false)
  scenes     Scene[]
  rooms      Room[]
  createdAt  DateTime @default(now())
}

// One curated cinematic line: video + original audio the player imitates.
model Scene {
  id         String   @id @default(cuid())
  title      String
  filmLabel  String   @default("")
  videoUrl   String
  audioUrl   String
  durationMs Int
  transcript String   @default("")
  emotionTag String   @default("")
  difficulty Int      @default(1) // 1-3
  pack       Pack     @relation(fields: [packId], references: [id], onDelete: Cascade)
  packId     String
  takes      Take[]
  createdAt  DateTime @default(now())

  @@index([packId])
}

// A single playthrough (solo run or one player's online session).
model Run {
  id           String   @id @default(cuid())
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId       String?
  mode         String   @default("solo") // 'solo' | 'online'
  roomCode     String?
  totalScore   Int      @default(0)
  scenesPlayed Int      @default(0)
  takes        Take[]
  createdAt    DateTime @default(now())

  @@index([userId])
}

// One recorded attempt at one scene.
model Take {
  id         String   @id @default(cuid())
  run        Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId      String
  scene      Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  sceneId    String
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId     String?
  audioUrl   String?
  judgeScore Int      @default(0)
  votes      Int      @default(0)
  commentary String   @default("")
  createdAt  DateTime @default(now())
  expiresAt  DateTime // R2/S3 lifecycle: cleaned up after 24h

  @@index([runId])
  @@index([expiresAt])
}

// ── Creator pipeline: upload a video → AI finds cut points → backend cuts it ──

// One uploaded source video and the state of its processing pipeline.
model VideoUpload {
  id         String         @id @default(cuid())
  // Short, human-friendly alphanumeric code used to share a video (e.g. for the
  // solo run). Nullable so existing rows migrate cleanly; backfilled on read.
  shareId    String?        @unique
  userId     String?
  title      String         @default("")
  // Content language of the dub, one of the app locales (en|es|fr|ru|ro) or null
  // when unset. Used to filter/group the shared library so visitors see videos
  // in their own language first instead of a wall of one dominant language.
  // Null rows are best-effort guessed from the title on read (see lang-detect).
  language   String?
  sourceKey  String // Spaces object key of the original upload
  sourceUrl  String // public URL of the original
  durationMs Int            @default(0)
  // uploaded | cutting | done | error
  status     String         @default("uploaded")
  // 'private' (only the creator sees it) | 'public' (listed in the shared
  // Video library for every user to browse and dub). Defaults to private so
  // nothing is exposed until the creator opts in.
  visibility String         @default("private")
  error      String         @default("")
  // Demucs music/FX bed (original audio with vocals removed), computed once per
  // source so dubbed sectors keep the original music.
  // none|processing|ready|error|invalid (invalid = source is corrupt; never retried).
  bedKey     String? // Spaces key of the separated no_vocals bed (full length)
  bedStatus  String         @default("none")
  // When the current bed job entered "processing". Lets a later trigger reclaim
  // a job whose worker died mid-separation (status stuck on "processing").
  bedStartedAt DateTime?
  // AI auto-sectoring job (isolate vocals → transcribe/diarize → build sectors).
  // Runs in the background like the bed. idle|processing|ready|error.
  autoStatus    String    @default("idle")
  autoStartedAt DateTime?
  autoError     String    @default("")
  segments   VideoSegment[]
  ratings    VideoRating[]
  plays      VideoPlay[]
  clips      Clip[]
  createdAt  DateTime       @default(now())

  @@index([userId])
  @@index([visibility])
  @@index([language])
}

// A finished dub of a PUBLIC library video, kept so it can compete on the
// dashboard's "Clips of Today" podium. Written once per completed render (solo
// export or party finish) when the source video is public. The "best" ranking is
// a pure-DSP performance score computed from the recorded voice takes (no AI):
// we store the raw audio features here and normalise them across the day's clips
// at read time (see lib/perf-clip.ts), so "loudest / most dynamic" is judged
// relative to the field rather than against magic thresholds.
model Clip {
  id       String      @id @default(cuid())
  upload   VideoUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  uploadId String
  videoUrl String // public Spaces URL of the rendered dub (the /watch clip)
  mode     String      @default("solo") // 'solo' | 'party'
  // Raw performance features from the voice takes (music/bed excluded):
  loudness Float    @default(-70) // integrated loudness, LUFS (higher = louder)
  lra      Float    @default(0) // loudness range, LU (dynamics / expressiveness)
  crest    Float    @default(1) // crest factor (peak-to-RMS punch)
  silence  Float    @default(0) // silence ratio 0..1 (1 = all silent → no coverage)
  voicedMs Int      @default(0) // total dubbed (voiced) duration across sectors
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([uploadId])
}

// One recorded playthrough ("run") of a library video: written when a solo run
// loads the video or a party locks it in to dub. Counted per day to rank the
// library's "most played today" window — a run = a launch, so a refresh/replay
// counts again, which is what "how often it's played today" should measure.
model VideoPlay {
  id        String      @id @default(cuid())
  upload    VideoUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  uploadId  String
  mode      String      @default("solo") // 'solo' | 'party'
  createdAt DateTime    @default(now())

  @@index([uploadId, createdAt])
}

// A 0–5 star rating a player gave a video after dubbing it (solo run or party).
// One row per rater per video (raterKey = the player's room seat id in a party,
// or a persistent per-browser client id in solo), upserted so re-rating just
// updates. Averaged per video for the "rank" shown in the shared library.
model VideoRating {
  id        String      @id @default(cuid())
  upload    VideoUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  uploadId  String
  raterKey  String // opaque id of who rated (room player id or browser client id)
  stars     Int // 0..5
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([uploadId, raterKey]) // one score per rater per video
  @@index([uploadId])
}

// One AI-detected moment to cut out, and (after cutting) the produced clip.
model VideoSegment {
  id         String      @id @default(cuid())
  upload     VideoUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  uploadId   String
  index      Int // ordering within the source
  player     Int         @default(1) // which player (1-4) dubs this sector, for multi-player dubs
  startMs    Int
  endMs      Int
  label      String      @default("")
  transcript String      @default("") @db.Text
  emotionTag String      @default("")
  // pending | cut | error
  status     String      @default("pending")
  partKey    String? // Spaces key of the cut clip
  partUrl    String? // public URL of the cut clip
  createdAt  DateTime    @default(now())

  @@index([uploadId])
}

// A finished dub someone chose to share. The rendered result MP4 already lives
// in Spaces (persistent, public-read); this row just gives it a short, shareable
// public URL (/watch/<id>) that anyone can open to watch the dub — no account,
// no relation to who made it. Created on demand when a player taps "Share".
model SharedDub {
  id        String   @id @default(cuid())
  videoUrl  String // public Spaces URL of the rendered dub
  title     String   @default("")
  mode      String   @default("solo") // 'solo' | 'party' — just for display
  createdAt DateTime @default(now())
}

// A live online room. 4-char code is the primary key. Holds up to 4 players
// (host + 3), tracked by the RoomPlayer join rows.
model Room {
  code      String       @id // 4 chars
  host      User?        @relation("RoomHost", fields: [hostId], references: [id], onDelete: SetNull)
  hostId    String?
  // 'lobby' (dashboard invite) | 'playing' (host picking a video on /party) |
  // 'dubbing' (everyone recording in the studio) | 'finished' (rendered)
  status    String       @default("lobby")
  pack      Pack?        @relation(fields: [packId], references: [id], onDelete: SetNull)
  packId    String?
  // The video the host locked in for a party dub, and the rendered result URL.
  videoUploadId String?
  finalUrl      String   @default("")
  // How many players were in the party when the host launched the current game.
  // Frozen at select so the sector→seat assignment (see lib/party-assign) is the
  // SAME on every client and on the server even if someone leaves mid-game — the
  // seat universe stays [1..seatCount], so nobody's sectors get reshuffled.
  seatCount Int          @default(0)
  round     Int          @default(0)
  players   RoomPlayer[]
  takes     RoomTake[]
  createdAt DateTime     @default(now())
}

// One seat in a room. Guests can join too, so userId is optional and the
// display name / colour are snapshotted here rather than always read from User.
// The row id doubles as the player's secret token (used to leave / act).
model RoomPlayer {
  id          String   @id @default(cuid())
  room        Room     @relation(fields: [roomCode], references: [code], onDelete: Cascade)
  roomCode    String
  userId      String? // null for guests
  displayName String
  avatarColor String   @default("#6F48FF")
  isHost      Boolean  @default(false)
  // The player's sector assignment, frozen when the host starts the game
  // (select). 0 while in the lobby (unassigned). Once dubbing, this is what maps
  // a player to their video sectors — NOT their live position in the roster — so
  // a mid-game leave can't reshuffle who dubs what. Cleared back to 0 on reset.
  seat        Int      @default(0)
  // 'playing' (still dubbing their sectors) | 'finished' (submitted takes)
  status      String   @default("playing")
  createdAt   DateTime @default(now())

  @@index([roomCode])
}

// One player's recorded take for one sector of the room's video. Uploaded when
// a player marks themselves finished; the host's render gathers all of them.
model RoomTake {
  id        String   @id @default(cuid())
  room      Room     @relation(fields: [roomCode], references: [code], onDelete: Cascade)
  roomCode  String
  segmentId String
  playerId  String
  partKey   String // Spaces object key of the recorded audio
  partUrl   String
  createdAt DateTime @default(now())

  @@unique([roomCode, segmentId]) // one owner per sector (seat → sector is 1:1)
  @@index([roomCode])
}

// A 0–5 star rating one player gave another after a finished party dub. Kept
// deliberately independent of Room/RoomPlayer lifecycle (plain string ids, no
// cascade) so the score survives after the room is recycled — the durable link
// is `ratedUserId`, which the dashboard aggregates into each member's rating.
// Guests can rate and be rated; a guest ratee just has a null ratedUserId, so
// their score is recorded but never surfaces on a dashboard.
model PlayerRating {
  id            String   @id @default(cuid())
  roomCode      String // which game this rating came from
  raterPlayerId String // RoomPlayer.id who gave the score
  ratedPlayerId String // RoomPlayer.id who received it
  // User.id of the rated player (null for guests). SetNull keeps the row if the
  // account is ever deleted.
  ratedUser     User?    @relation("RatedUser", fields: [ratedUserId], references: [id], onDelete: SetNull)
  ratedUserId   String?
  stars         Int // 0..5
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([roomCode, raterPlayerId, ratedPlayerId]) // one score per pair per game
  @@index([ratedUserId])
  @@index([roomCode])
}
