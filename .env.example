# Copy to .env.local and fill in. Never commit real secrets.

# Self-hosted Postgres 18, e.g. postgresql://voicer:<password>@127.0.0.1:5432/voicer
# (see docs/DATABASE.md)
DATABASE_URL=
# Old Neon connection string — only read by scripts/db/migrate-from-neon.sh
NEON_DATABASE_URL=

# Database backups (scripts/db/backup.sh). MUST be a PRIVATE bucket, never the
# public media bucket. Credentials default to DO_SPACES_ENDPOINT/KEY/SECRET;
# set BACKUP_S3_ENDPOINT / BACKUP_S3_ACCESS_KEY_ID / BACKUP_S3_SECRET_ACCESS_KEY
# to use a separate token scoped to the backup bucket.
BACKUP_BUCKET=dubthatmovie-db-backups
BACKUP_PREFIX=local

# Clerk (dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Cloudflare R2 / S3-compatible bucket for recorded takes (24h lifecycle)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Realtime socket server (browser-facing URL)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Public base URL used to build shareable /watch links. Optional — if unset, the
# browser's current origin is used (already the real domain in production). Set
# it on the server to force the canonical domain, e.g. https://dubthatmovie.com
NEXT_PUBLIC_SITE_URL=

# PostHog analytics (EU cloud). Paste the "Project API key" from
# PostHog → Settings → Project. Leave blank to disable analytics entirely
# (nothing is loaded or sent). Events are proxied through /ingest (next.config).
NEXT_PUBLIC_POSTHOG_KEY=
